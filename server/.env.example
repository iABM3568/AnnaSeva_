# Port the Express API server listens on (default: 5000)
PORT=5000

# MongoDB Atlas connection string (use a *_dev database for development)
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/annaseva_dev?retryWrites=true&w=majority

# Secret key used to sign and verify JWT authentication tokens (use a long random string)
JWT_SECRET=a-long-random-string-generated-with-crypto

# Allowed frontend origin for CORS and Socket.IO connections (Vite default: http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Node environment: 'development' or 'production'
NODE_ENV=development

# Optional: Maximum general API requests per 15-minute window per IP (default: 1000)
RATE_LIMIT_MAX=1000
